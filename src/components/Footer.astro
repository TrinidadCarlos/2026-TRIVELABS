---
import Image from "astro/components/Image.astro";
import "@styles/components/footer.css";
import logoYellow from "@assets/images/LOGO-YELLOW.png";
import whatsappIcon from "@assets/images/whatsapp.png";
import facebookIcon from "@assets/images/facebook.png";
import githubIcon from "@assets/images/github.png";
import emailIcon from "@assets/images/check-blue.png";

const currentYear = new Date().getFullYear();
---

<footer class="footer-container">
  <div class="footer-glow"></div>
  <section class="info-section">
    <section class="footer-logo">
      <div class="footer-img">
        <Image src={logoYellow} alt="TriveLabs logo" />
      </div>
    </section>
    <section class="footer-text">
      <h2>Contáctanos sin compromiso y hagamos juntos que tu sitio sea real</h2>
    </section>

    <section class="btns-container">
      <button class="g-button-rounded btn-whatsapp">
        <div class="btn-image-container">
          <Image src={whatsappIcon} alt="Icono de whatsapp" />
        </div>
        <span>Whatsapp</span>
      </button>
      <button class="g-button-rounded btn-email">
        <div class="btn-image-container">
          <Image src={emailIcon} alt="Icono de email/correo" />
        </div>
        <span>correo@correo.com</span>
      </button>
    </section>
  </section>
  <section class="copyright-section">
    <ul class="terms-privacy">
      <li><a href="/terms-and-conditions">Términos y condiciones</a></li>
      <li><a href="/privacy">Aviso de privacidad</a></li>
    </ul>
    <p>© {currentYear} TriveLabs. Todos los derechos reservados.</p>
    <ul class="social-links-footer">
      <li>
        <a href="#" aria-label="Facebook"><Image src={facebookIcon} alt="icono de facebook" /></a>
      </li>
      <li>
        <a href="#" aria-label="Github"><Image src={githubIcon} alt="icono de github" /></a>
      </li>
      <li>
        <a href="#" aria-label="Whatsapp"><Image src={whatsappIcon} alt="icono de whatsapp" /></a>
      </li>
    </ul>
  </section>
</footer>
