---
import "@styles/components/projectCard.css";
import type { Project } from "@typings/types";

interface Props extends Project {}

const {
  title,
  description,
  image,
  link,
  deliveryTime,
  type,
  brand = "trivelabs",
} = Astro.props;

// Map type to a specific color/class
const typeConfig = {
  Landing: { color: "var(--color-t-scooter-500)", icon: "🎯" },
  "Sitio Web": { color: "var(--color-t-midnight-400)", icon: "🌐" },
  CMS: { color: "var(--color-t-dark-blue)", icon: "⚙️" },
};

const currentType = typeConfig[type] || typeConfig["Sitio Web"];
---

<div class="project-card">
  <div class="project-image-container">
    <img src={image} alt={title} loading="lazy" />
    <div
      class="project-type-tag"
      style={`background-color: ${currentType.color}`}
    >
      <span class="type-icon">{currentType.icon}</span>
      {type}
    </div>
  </div>

  <div class="project-content">
    <div class="project-header">
      <span class="project-brand">{brand}</span>
      <span class="delivery-time">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="10"></circle><polyline
            points="12 6 12 12 16 14"></polyline></svg
        >
        {deliveryTime}
      </span>
    </div>

    <h3 class="project-title">{title}</h3>
    <p class="project-description">{description}</p>

    <div class="project-footer">
      <a
        href={link}
        class="project-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        Explorar proyecto
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
          ></path><polyline points="15 3 21 3 21 9"></polyline><line
            x1="10"
            y1="14"
            x2="21"
            y2="3"></line></svg
        >
      </a>
    </div>
  </div>
</div>
