---
// import logoWhite from "@assets/images/LOGO.png";
import logoYellow from "@assets/images/LOGO-YELLOW.png";
import { Picture } from "astro:assets";
---

<style>
  .header-desktop {
    display: none;
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    height: 8rem;
    padding: var(--t-padding-90);
    background-color: var(--color-t-midnight-950);
    box-shadow: 0 0 0.5rem 0 var(--color-t-midnight-900);
    @media (min-width: 768px) {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    @media (min-width: 1024px) {
      padding: var(--t-padding-85);
    }
  }

  .header-desktop__logo {
    padding-top: 1.3rem;
    width: 11rem;
    /* height: 10rem; */
  }

  .header-desktop__nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2rem;
    width: 75%;
    font-size: 1.4rem;
    @media (min-width: 1284px) {
      gap: 3.5rem;
    }

    ul {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;

      li {
        margin-top: 0.5rem;
        padding-bottom: 0.2rem;
        border-bottom: 0.3rem solid transparent;
        transition: all 0.3s ease-in-out;
        color: var(--color-t-scooter-300);
        font-size: 1.9rem;
        font-weight: 700;
      }
      li:hover {
        color: var(--color-t-saratoga-300);
        border-color: var(--color-t-saratoga-200);
        transform: scale(1.05);
        font-weight: 600;
      }
    }
  }

  .header-desktop__nav-btn-quote {
    button {
      background-color: transparent;
      box-shadow: 0 0 0.4rem 0 var(--color-t-saratoga-500);
      color: var(--color-t-saratoga-500);
      width: fit-content;
      letter-spacing: 0.1rem;
      padding: 1rem;
      transition: all 0.3s ease-in-out;
      font-size: 1.7rem;
      font-weight: 700;

      &:hover {
        box-shadow: 0 0 1rem 0 var(--color-t-saratoga-300);
        font-weight: 700;
      }
    }
  }
</style>

<header class={`header-desktop`}>
  <a href="/" class={`header-desktop__logo`} title="Ir a la página de inicio">
    <Picture
      src={logoYellow}
      alt="TriveLabs logo"
      formats={["avif", "webp", "png"]}
    />
  </a>
  <section class={`header-desktop__nav`}>
    <ul>
      <li><a href="/">Inicio</a></li>
      <li><a href="/about">Nosotros</a></li>
      <li><a href="/projects">Proyectos</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/services">Servicios</a></li>
    </ul>
    <div class={`header-desktop__nav-btn-quote`}>
      <button class={`g-button-rounded`}>Cotiza tu sitio</button>
    </div>
  </section>
</header>
