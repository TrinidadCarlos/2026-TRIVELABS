---
import type { Service } from "@typings/types";
import "@styles/components/serviceCards.css";
interface Props {
    service: Service;
}
const { service } = Astro.props;

const getTotalPrice = (price: number, discountPercentage: number) => {
    const discountAmount = (price * discountPercentage) / 100;
    return price - discountAmount;
};
---

<article class="service-content">
    <div class="service-content_header">
        <h3 class="service-content_title">{service.level}</h3>
        {
            service.discountPercentage &&
                Number(service.discountPercentage) > 0 && (
                    <div class="service-content_discount">
                        Descuento <span>{service.discountPercentage}%</span>
                    </div>
                )
        }
    </div>
    
    <p class="service-content_desc">{service.description}</p>

    <div class="service-content_includes">
        <h4>¿Qué incluye?</h4>
        <ul>
            {service.includes.map((item) => (
                <li>
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </span>
                    <span class="text">{item}</span>
                </li>
            ))}
        </ul>
    </div>

    <div class="service-content_meta">
        <p class="service-content_bestfor">
            Perfecto para: <br/><span>{service.bestFor}</span>
        </p>
        <p class="service-content_delivery">
            Aprox. entrega: <br/><span>{service.timeDelivery}</span>
            <small>Los tiempos pueden variar según requerimientos.</small>
        </p>
    </div>

    <div class="service-content_footer">
        <div class="service-content_price-wrapper">
            {
                service?.discountPercentage &&
                Number(service.discountPercentage) > 0 ? (
                    <>
                        <p class="service-content_original-price">${service.priceValue}</p>
                        <p class="service-content_total">
                            <span>$</span>
                            {getTotalPrice(
                                Number(service.priceValue),
                                Number(service.discountPercentage),
                            )}
                        </p>
                    </>
                ) : (
                    <p class="service-content_total">{service.price}</p>
                )
            }
        </div>
        <div class="service-content_get">
            <a href="#" class="btn-contratar">Contratar</a>
        </div>
    </div>
</article>
