---
import Layout from "@layouts/Layout.astro";
import type { BlogPost } from "@typings/types";
import "@styles/pages/blogPage.css";
import BlogSection from "@components/BlogSection.astro";
import { blogPostsBlog as allPosts } from "@constants/dataSite";

const pageDesc =
  "Mantente informado con nuestras publicaciones en nuestro blog. Encontrarás información sobre desarrollo web, marketing digital y mucho más.";

const blogPost: BlogPost = {
  title: "React 20: ¿Qué hay de nuevo?",
  description:
    "Analizamos las nuevas funcionalidades de la versión más reciente de React, incluyendo el compilador automático optimizado.",
  content:
    "<p>La llegada de <strong>React 20</strong> marca un antes y un después en el ecosistema de JavaScript. Tras años de investigación, el equipo de Meta ha entregado una versión que no solo mejora el rendimiento, sino que redefine la forma en que escribimos componentes, eliminando gran parte de la carga mental que recaía sobre los desarrolladores.</p><h3>El Compilador de React: El fin de useMemo y useCallback</h3><p>La joya de la corona en esta versión es el <strong>React Compiler</strong>. Anteriormente, para evitar re-renders innecesarios, debíamos memorizar manualmente funciones y valores. Con React 20, esto ocurre de forma automática bajo el capó.</p><ul><li><strong>Optimización automática:</strong> El compilador analiza el árbol de componentes y decide qué partes deben actualizarse basándose exclusivamente en los cambios de estado.</li><li><strong>Adiós al boilerplate:</strong> Ya no es necesario envolver cada función en un <code>useCallback</code>, lo que resulta en un código mucho más limpio y legible.</li><li><strong>Compatibilidad total:</strong> No requiere cambios drásticos en la sintaxis actual; simplemente funciona con tu código existente de React.</li></ul><h3>Acciones de Servidor y Optimismo en la UI</h3><p>Siguiendo la evolución hacia una web más híbrida, React 20 consolida las <strong>Server Actions</strong>. Ahora es posible manejar mutaciones de datos directamente desde el cliente hacia el servidor con una integración nativa de estados de carga y errores.</p><p>Además, el nuevo hook <code>useOptimistic</code> se vuelve fundamental para mejorar la experiencia de usuario, permitiendo que la interfaz responda instantáneamente mientras la operación se confirma en segundo plano.</p><h3>Mejoras en la Hidratación y Streaming</h3><p>El renderizado en el servidor ha recibido una actualización crítica. La hidratación ahora es <strong>progresiva y selectiva</strong> por defecto, lo que significa:</p><ol><li>El contenido interactivo se prioriza sobre el estático.</li><li>Menor tiempo de bloqueo en el hilo principal durante la carga inicial.</li><li>Streaming de datos más eficiente mediante Suspense.</li></ol><h3>Reflexión Final</h3><p>React 20 no se trata de añadir más complejidad, sino de abstraerla. Para equipos de desarrollo que buscan interfaces rápidas y escalables, esta versión reduce la deuda técnica significativamente.</p><p>Puedes consultar la documentación oficial para profundizar en los cambios de la API y las guías de migración en <a href='https://react.dev' target='_blank'>react.dev</a>.</p>",
  image:
    "https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&q=80&w=600",
  tags: ["React", "JavaScript", "Frontend"],
  relevance: "Dev News",
  relevanceType: "dev",
  date: "06/03/2026",
  publishedBy: "Trivelabs",
};

const blogPosts: BlogPost[] = allPosts.slice(0, 3);
---

<Layout title="Blog" description={pageDesc}>
  <div class="blog-page-top-bg"></div>

  <main class="blog-container">
    <div class="post-image-container">
      <figure class="">
        <img src={blogPost.image} alt={blogPost.title} />
      </figure>
      <p class={`post-badge relevance-badge ${blogPost.relevanceType}`}>
        {blogPost.relevance}
      </p>
    </div>
    <div class="post-header">
      <h4>{blogPost.date}</h4>
      <h5><span>Pulicado por: </span> {blogPost.publishedBy}</h5>
    </div>

    <div class="post-tags">
      {blogPost.tags.map((tag) => <span class="tag">#{tag}</span>)}
    </div>

    <article class="post">
      <div class="post-container">
        <div class="post-content">
          <h1 class="post-title">{blogPost.title}</h1>
          <div class="post-body" set:html={blogPost.content} />
        </div>
        <section class="post-share">
          <div class="social-container">
            <h4 class="social-title">Compartir</h4>
            <ul>
              <li>
                <a target="_blank" rel="noopener noreferrer" href="#">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="24"
                    width="24"
                    viewBox="0 0 640 640"
                    ><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path
                      fill="rgb(255, 212, 59)"
                      d="M240 363.3L240 576L356 576L356 363.3L442.5 363.3L460.5 265.5L356 265.5L356 230.9C356 179.2 376.3 159.4 428.7 159.4C445 159.4 458.1 159.8 465.7 160.6L465.7 71.9C451.4 68 416.4 64 396.2 64C289.3 64 240 114.5 240 223.4L240 265.5L174 265.5L174 363.3L240 363.3z"
                    ></path></svg
                  >
                </a>
              </li>
              <li>
                <a target="_blank" rel="noopener noreferrer" href="#">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="24"
                    width="24"
                    viewBox="0 0 640 640"
                    ><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                    <path
                      fill="rgb(255, 212, 59)"
                      d="M453.2 112L523.8 112L369.6 288.2L551 528L409 528L297.7 382.6L170.5 528L99.8 528L264.7 339.5L90.8 112L236.4 112L336.9 244.9L453.2 112zM428.4 485.8L467.5 485.8L215.1 152L173.1 152L428.4 485.8z"
                    ></path></svg
                  ></a
                >
              </li>
            </ul>
          </div>
        </section>
      </div>

      <aside class={`aside-post post-blogs-container`}>
        <h2 class={`aside-post-title`}>Otros artículos</h2>

        <BlogSection posts={blogPosts} />
      </aside>
    </article>
  </main>
</Layout>
