---
import HeaderNavMobile from "@components/headerNav/HeaderNavMobile.astro";
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";

import HeaderNavDesktop from "@components/headerNav/HeaderNavDesktop.astro";
import ScrollTopTopButton from "@components/shared/ScrollTopTopButton.astro";

const {
  title = "",
  description = "",
  image = "/images/portada.png",
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <HeaderNavMobile />
    <HeaderNavDesktop />
    <slot />
    <ScrollTopTopButton />
  </body><Footer />
</html>

<script>
  import { initAnimations } from "@utils/animations";

  // Se ejecuta al cargar por primera vez y tras cada navegación
  document.addEventListener("astro:page-load", () => {
    initAnimations();
  });
</script>
